# Copy this to .env.local and fill in your values
# Vite proxy uses these server-side so your token never touches the browser

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token with repo + read:user scopes
VITE_GITHUB_TOKEN=your-github-pat
# Comma-separated list of owner/repo pairs to track PRs in
VITE_GITHUB_REPOS=your-org/your-repo,your-org/another-repo

# ─── Google Calendar ──────────────────────────────────────────────────────────
# OAuth2 access token with https://www.googleapis.com/auth/calendar.readonly scope
VITE_GCAL_TOKEN=your-google-oauth-access-token
# Calendar ID to query (use "primary" for the main calendar)
VITE_GCAL_CALENDAR_ID=primary

# ─── Slack ────────────────────────────────────────────────────────────────────
# Bot token with channels:read, search:read scopes
VITE_SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ─── Gmail ────────────────────────────────────────────────────────────────────
# OAuth2 access token with https://www.googleapis.com/auth/gmail.readonly scope
VITE_GMAIL_TOKEN=your-gmail-oauth-access-token

# ─── Linear ───────────────────────────────────────────────────────────────────
# Personal API key from https://linear.app/settings/api
VITE_LINEAR_TOKEN=lin_api_your-linear-token

# ─── OpenAI (for smart voice search) ─────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-openai-api-key
